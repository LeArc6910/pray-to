#!/usr/bin/env bash
# Stands in for the Unity editor in run.sh: reads the arguments the setup scripts pass and leaves behind what a real
# run would (a log, an asset, packages-lock.json, NUnit results, and for the Screens category screenshots in
# Logs/screens). FAKE_LICENSE_FAIL, FAKE_SETUP_FAIL, FAKE_PLAY_FAIL, FAKE_EDIT_INCONCLUSIVE, FAKE_TOUCH_CS and
# FAKE_SCREENS_HANG switch on the failures and doubtful results the scripts must report; FAKE_SCREENS_LINGER keeps the
# windowed run open after its results are written, as an editor that does not close by itself would.
log=""
results=""
platform=""
category=""
project=""
mode=setup
while [ $# -gt 0 ]; do
    case "$1" in
        -logFile) log="$2"; shift ;;
        -testResults) results="$2"; shift ;;
        -testPlatform) platform="$2"; shift ;;
        -projectPath) project="$2"; shift ;;
        -testCategory) category="$2"; shift ;;
        -runTests) mode=tests ;;
    esac
    shift
done
echo "fake unity: $mode $platform" > "$log"

if [ "$mode" = setup ]; then
    if [ -n "${FAKE_LICENSE_FAIL:-}" ]; then
        {
            echo "[Licensing::Module] Error: Access token is unavailable; failed to update"
            echo "[Licensing::Module] Error: 'com.unity.editor.headless' was not found."
            echo "Exiting without the bug reporter. Application will exit with return code 198"
        } >> "$log"
        exit 198
    fi
    if [ -n "${FAKE_SETUP_FAIL:-}" ]; then
        {
            echo "Assets/_Project/Scripts/Client/GameRoot.cs(1,1): error CS0246: The type or namespace name 'Foo' could not be found"
            echo "Aborting batchmode due to failure:"
        } >> "$log"
        exit 1
    fi
    mkdir -p "$project/Assets/_Project/Settings"
    echo "asset" > "$project/Assets/_Project/Settings/URP-2D.asset"
    printf '{\n  "dependencies": {\n    "com.unity.netcode.gameobjects": {\n      "version": "2.13.3",\n      "depth": 0\n    }\n  }\n}\n' \
        > "$project/Packages/packages-lock.json"
    if [ -n "${FAKE_TOUCH_CS:-}" ]; then echo "// changed by the API updater" >> "$project/Assets/_Project/Scripts/Client/Palette.cs"; fi
    exit 0
fi

if [ "$platform" = PlayMode ] && [ -n "${FAKE_PLAY_FAIL:-}" ]; then
    cat > "$results" <<'XML'
<?xml version="1.0" encoding="utf-8"?>
<test-run id="2" testcasecount="2" result="Failed(Child)" total="2" passed="1" failed="1" inconclusive="0" skipped="0">
  <test-suite type="TestFixture" name="SessionTests" fullname="Game.Client.Tests.SessionTests">
    <test-case id="1" name="SoloSessionRuns" fullname="Game.Client.Tests.SessionTests.SoloSessionRuns" result="Passed" />
    <test-case id="2" name="HostSessionRuns" fullname="Game.Client.Tests.SessionTests.HostSessionRuns" result="Failed">
      <failure>
        <message><![CDATA[
  The host session never started playing.
  Expected: True]]></message>
      </failure>
    </test-case>
  </test-suite>
</test-run>
XML
    exit 2
fi

if [ "$platform" = EditMode ] && [ -n "${FAKE_EDIT_INCONCLUSIVE:-}" ]; then
    cat > "$results" <<'XML'
<?xml version="1.0" encoding="utf-8"?>
<test-run id="2" testcasecount="140" result="Passed" total="140" passed="139" failed="0" inconclusive="1" skipped="0">
  <test-suite type="TestFixture" name="ElementTests" fullname="Game.Core.Tests.ElementTests">
    <test-case id="1" name="ColdSlowsAMonsterDown" fullname="Game.Core.Tests.ElementTests.ColdSlowsAMonsterDown" result="Inconclusive">
      <reason>
        <message><![CDATA[  the frost bolt landed
  Expected: True]]></message>
      </reason>
    </test-case>
  </test-suite>
</test-run>
XML
    exit 0
fi

# The cloud pushes to main while the tests run, so the results commit has to go on top of it.
if [ -n "${FAKE_PUSH_RACE:-}" ] && [ "$platform" = PlayMode ] && [ -z "$category" ]; then
    url="$(git -C "$project" remote get-url origin)"
    race="$(mktemp -d)"
    git clone -q --branch main "$url" "$race/clone"
    (
        cd "$race/clone" || exit 1
        git config user.name cloud
        git config user.email cloud@example.com
        echo race > race.txt
        git add race.txt
        git commit -q -m "Cloud change meanwhile"
        git push -q origin HEAD:main
    )
    rm -rf "$race"
fi

if [ "$category" = Screens ]; then
    # The windowed screenshot run: never ends when asked to hang, else two pictures.
    if [ -n "${FAKE_SCREENS_HANG:-}" ]; then
        echo "NullReferenceException: Object reference not set to an instance of an object" >> "$log"
        sleep 600
    fi
    mkdir -p "$project/Logs/screens"
    printf 'jpg' > "$project/Logs/screens/solo.jpg"
    printf 'jpg' > "$project/Logs/screens/combo.jpg"
    cat > "$results" <<'XML'
<?xml version="1.0" encoding="utf-8"?>
<test-run id="2" testcasecount="7" result="Passed" total="7" passed="7" failed="0" inconclusive="0" skipped="0">
</test-run>
XML
    if [ -n "${FAKE_SCREENS_LINGER:-}" ]; then sleep 600; fi
    exit 0
fi

total=140
[ "$platform" = PlayMode ] && total=2
cat > "$results" <<XML
<?xml version="1.0" encoding="utf-8"?>
<test-run id="2" testcasecount="$total" result="Passed" total="$total" passed="$total" failed="0" inconclusive="0" skipped="0">
</test-run>
XML
exit 0
