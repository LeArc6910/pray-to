<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the Unity-side scripts against Unity's real engine assemblies (fetched by fetch-unity.sh) and
       hand-written stand-ins for the package APIs they use (Stubs/). Catches compile errors before the
       editor does; nothing here runs. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UnityAssemblies>$(MSBuildThisFileDirectory).unity/Managed/UnityEngine</UnityAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Stubs/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Client/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(UnityAssemblies)/UnityEngine.*Module.dll" Private="false" />
    <Reference Include="$(UnityAssemblies)/UnityEditor.*Module.dll" Private="false" />
    <Reference Include="$(UnityAssemblies)/UnityEditor.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Game.Core/Game.Core.csproj" />
  </ItemGroup>

  <Target Name="RequireUnityAssemblies" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(UnityAssemblies)/UnityEngine.CoreModule.dll')">
    <Error Text="Unity assemblies are missing. Run DevTools/UnityCompileCheck/fetch-unity.sh first." />
  </Target>

</Project>
